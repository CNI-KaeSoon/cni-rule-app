[
  {
    "description": "주제어로 여러 기관 규정을 나란히 대조한다. no_match_found는 '이 질의로 대응 조문을 확인하지 못함'이며 조문 부재의 단정이 아니다. query_variants로 동의어를 바꿔 재시도한 뒤에도 없으면 개선 검토 후보로 다뤄라. semantic_candidate는 검증 필요 후보이다. rank_score는 기관 내 정렬 전용으로 기관 간 비교할 수 없다. body가 truncated/omitted면 get_article·get_annex로 전문을 확인하라.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "include_body": {
          "default": null,
          "description": "본문 포함 여부. 기본값은 false입니다.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "institutions": {
          "default": null,
          "description": "대조 기관 slug. 생략하면 로드된 전체 팩이며 최대 12개입니다.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "query_variants": {
          "default": null,
          "description": "동의어·표현 변형. 최대 5개이며 topic이 항상 우선합니다.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "top_k_per_institution": {
          "default": null,
          "description": "기관당 최대 조문 수. 기본 3이며 1..=10 범위로 보정됩니다.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "topic": {
          "description": "비교 주제. trim 후 비어 있으면 오류입니다.",
          "type": "string"
        }
      },
      "required": [
        "topic"
      ],
      "type": "object"
    },
    "name": "compare_rules",
    "outputSchema": {
      "$defs": {
        "ArticleRef": {
          "properties": {
            "target": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          },
          "required": [
            "target",
            "type"
          ],
          "type": "object"
        },
        "ComparedProvision": {
          "properties": {
            "amended": {
              "type": "string"
            },
            "annex_refs": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "article": {
              "type": "string"
            },
            "body": {
              "type": [
                "string",
                "null"
              ]
            },
            "body_state": {
              "type": "string"
            },
            "effective": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "legal_basis": {
              "items": {
                "$ref": "#/$defs/LegalBasis"
              },
              "type": "array"
            },
            "match_evidence": {
              "$ref": "#/$defs/MatchEvidence"
            },
            "pages": {
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "rank_score": {
              "description": "기관 내부 정렬 전용 점수이며 기관 간 비교에는 사용할 수 없습니다.",
              "format": "float",
              "type": "number"
            },
            "refs": {
              "items": {
                "$ref": "#/$defs/ArticleRef"
              },
              "type": "array"
            },
            "rule": {
              "type": "string"
            },
            "snippet": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind",
            "rule",
            "article",
            "title",
            "effective",
            "amended",
            "status",
            "rank_score",
            "snippet",
            "match_evidence",
            "body_state",
            "legal_basis",
            "refs",
            "annex_refs",
            "pages"
          ],
          "type": "object"
        },
        "FreshnessMeta": {
          "properties": {
            "amended": {
              "type": "string"
            },
            "effective": {
              "type": "string"
            },
            "extra": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "source_commit": {
              "type": "string"
            }
          },
          "required": [
            "effective",
            "amended",
            "source_commit",
            "extra"
          ],
          "type": "object"
        },
        "InstitutionComparison": {
          "properties": {
            "freshness": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FreshnessMeta"
                },
                {
                  "type": "null"
                }
              ]
            },
            "institution": {
              "type": "string"
            },
            "match_status": {
              "$ref": "#/$defs/MatchStatus",
              "description": "no_match_found는 '이 질의로 대응 조문을 확인하지 못함'이며 조문 부재의 단정이 아닙니다."
            },
            "provisions": {
              "items": {
                "$ref": "#/$defs/ComparedProvision"
              },
              "type": "array"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "institution",
            "match_status",
            "provisions"
          ],
          "type": "object"
        },
        "LegalBasis": {
          "properties": {
            "article": {
              "type": "string"
            },
            "law": {
              "type": "string"
            },
            "mst": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "law",
            "article"
          ],
          "type": "object"
        },
        "MatchEvidence": {
          "properties": {
            "fields": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "pinned": {
              "type": "boolean"
            },
            "variant": {
              "type": "string"
            }
          },
          "required": [
            "variant",
            "fields",
            "pinned"
          ],
          "type": "object"
        },
        "MatchStatus": {
          "oneOf": [
            {
              "enum": [
                "search_error",
                "pack_not_loaded",
                "lexical_match",
                "exact_match"
              ],
              "type": "string"
            },
            {
              "const": "no_match_found",
              "description": "이 질의로 대응 조문을 확인하지 못함. 조문 부재를 뜻하지 않습니다.",
              "type": "string"
            },
            {
              "const": "semantic_candidate",
              "description": "검색 결과 중 lexical/exact 근거가 없어 검증이 필요한 후보입니다.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "institutions": {
          "items": {
            "$ref": "#/$defs/InstitutionComparison"
          },
          "type": "array"
        },
        "topic": {
          "type": "string"
        }
      },
      "required": [
        "topic",
        "institutions"
      ],
      "type": "object"
    }
  },
